<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ufactory_lite6_moveit_config</name>
  <version>1.0.0</version>
  <description>
    MoveIt 2 configuration and bringup for the UFACTORY Lite 6, wired into the
    vendor-agnostic motion_control stack. The kinematics/geometry come from the
    vendor xarm_description package; this package only adds the top-level URDF,
    the SRDF, the MoveIt configuration and the bringup launch file.
  </description>
  <maintainer email="antochauvet@gmail.com">Antonin Chauvet</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ros2launch</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>xarm_description</exec_depend>
  <exec_depend>xarm_controller</exec_depend>
  <exec_depend>tool</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_planners_ompl</exec_depend>
  <exec_depend>pilz_industrial_motion_planner</exec_depend>
  <exec_depend>moveit_simple_controller_manager</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
