+++ b/denso_ros2_ws/src/joint_monitor/joint_monitor/joint_kinematics_publisher_node.py
@@ -0,0 +1,233 @@
+"""
+JointKinematicsPublisherNode
+============================
+Continuously publishes the POSITION, VELOCITY and ACCELERATION of every joint
+found on /joint_states, for live display in PlotJuggler — the joint-space
+counterpart of tool_pose_publisher_node (which does the same for the Cartesian
+TCP).
+
+Why differentiate ourselves?
+    Like joint_monitor_node, this node computes velocity and acceleration from
+    the POSITION by finite differences, because the Gazebo position controller
+    (GazeboSystem) calls SetVelocity(0) every cycle, so msg.velocity is ~0 and
+    unusable. On a real driver that DOES publish a valid velocity you can set
+    ~use_msg_velocity=true to trust msg.velocity instead of differentiating.
+    Acceleration is always differentiated (no msg field carries it).
+
+    The differentiation reuses the proven scheme from joint_monitor_node:
+      * velocity     : first difference of position, smoothed by an EMA filter
+      * acceleration : first difference of velocity, DECIMATED (computed every
+                       N samples so the effective dt is larger and the double
+                       differentiation is far less noisy) and smoothed by a
+                       second EMA filter.
+
+Published topics (one set per joint, created lazily as joints are discovered)
+----------------------------------------------------------------------------
+  ~/<joint>/position      (std_msgs/Float64)  joint position     [rad]
+  ~/<joint>/velocity      (std_msgs/Float64)  joint velocity     [rad/s]
+  ~/<joint>/acceleration  (std_msgs/Float64)  joint acceleration [rad/s^2]
+
+Parameters
+----------
+  joint_states_topic (str,   default '/joint_states')  input topic
+  use_msg_velocity   (bool,  default False)  trust msg.velocity instead of
+                                             differentiating position (real
+                                             driver only; leave False on Gazebo)
+  vel_alpha          (float, default 0.2)  EMA factor on the velocity
+                                           (0 = no update, 1 = no smoothing)
+  acc_alpha          (float, default 0.3)  EMA factor on the acceleration
+  acc_decimation     (int,   default 10)   compute acceleration every N samples
+"""
+
+import math
+
+import rclpy
+from rclpy.node import Node
+
+from sensor_msgs.msg import JointState
+from std_msgs.msg import Float64
+
+
+class _JointKinematics:
+    """Per-joint differentiator: position -> (velocity, acceleration).
+
+    Mirrors the finite-difference + EMA scheme used by joint_monitor_node's
+    JointStats, but instead of tracking min/max it just returns the latest
+    filtered values so they can be published live.
+    """
+
+    def __init__(self, vel_alpha: float, acc_alpha: float, acc_decimation: int):
+        self._vel_alpha = vel_alpha
+        self._acc_alpha = acc_alpha
+        self._acc_decimation = max(1, acc_decimation)
+
+        self.prev_pos = None        # last position [rad]
+        self.prev_stamp = None      # last timestamp [s]
+        self.filtered_vel = 0.0     # EMA-filtered velocity [rad/s]
+        self.filtered_acc = 0.0     # EMA-filtered acceleration [rad/s^2]
+
+        # Acceleration is computed on a decimated stream to enlarge dt.
+        self._acc_counter = 0
+        self._acc_prev_vel = None
+        self._acc_prev_stamp = None
+        self._have_acc = False      # becomes True once a first accel is computed
+
+    def reset(self):
+        """Drop history so no bogus derivative spans a gap (e.g. after a pause)."""
+        self.prev_pos = None
+        self.prev_stamp = None
+        self.filtered_vel = 0.0
+        self.filtered_acc = 0.0
+        self._acc_counter = 0
+        self._acc_prev_vel = None
+        self._acc_prev_stamp = None
+        self._have_acc = False
+
+    def update(self, position: float, stamp_sec: float, msg_velocity):
+        """Feed one sample; return (velocity, acceleration_or_None).
+
+        acceleration is None until enough decimated velocity samples exist.
+        When msg_velocity is not None it is used directly (real driver) and only
+        the acceleration is differentiated.
+        """
+        if self.prev_pos is None or self.prev_stamp is None:
+            # First sample: seed history, nothing to differentiate yet.
+            self.prev_pos = position
+            self.prev_stamp = stamp_sec
+            if msg_velocity is not None:
+                self.filtered_vel = msg_velocity
+            return self.filtered_vel, None
+
+        dt = stamp_sec - self.prev_stamp
+        if dt < 1e-9:
+            # Duplicate timestamp — skip to avoid division by zero.
+            return self.filtered_vel, (self.filtered_acc if self._have_acc else None)
+
+        # ── Velocity ──
+        if msg_velocity is not None:
+            # Trust the driver's velocity, but still EMA-smooth it lightly.
+            self.filtered_vel = (
+                self._vel_alpha * self.filtered_vel
+                + (1.0 - self._vel_alpha) * msg_velocity
+            )
+        else:
+            raw_vel = (position - self.prev_pos) / dt
+            self.filtered_vel = (
+                self._vel_alpha * self.filtered_vel
+                + (1.0 - self._vel_alpha) * raw_vel
+            )
+        velocity = self.filtered_vel
+
+        # ── Acceleration (decimated + filtered) ──
+        self._acc_counter += 1
+        if self._acc_counter >= self._acc_decimation:
+            self._acc_counter = 0
+            if self._acc_prev_vel is not None and self._acc_prev_stamp is not None:
+                acc_dt = stamp_sec - self._acc_prev_stamp
+                if acc_dt > 1e-9:
+                    raw_acc = (velocity - self._acc_prev_vel) / acc_dt
+                    self.filtered_acc = (
+                        self._acc_alpha * self.filtered_acc
+                        + (1.0 - self._acc_alpha) * raw_acc
+                    )
+                    self._have_acc = True
+            self._acc_prev_vel = velocity
+            self._acc_prev_stamp = stamp_sec
+
+        self.prev_pos = position
+        self.prev_stamp = stamp_sec
+        return velocity, (self.filtered_acc if self._have_acc else None)
+
+
+class JointKinematicsPublisherNode(Node):
+    def __init__(self):
+        super().__init__('joint_kinematics_publisher')
+
+        self.declare_parameter('joint_states_topic', '/joint_states')
+        self.declare_parameter('use_msg_velocity', False)
+        self.declare_parameter('vel_alpha', 0.2)
+        self.declare_parameter('acc_alpha', 0.3)
+        self.declare_parameter('acc_decimation', 10)
+
+        topic = self.get_parameter('joint_states_topic').get_parameter_value().string_value
+        self._use_msg_velocity = self.get_parameter('use_msg_velocity').get_parameter_value().bool_value
+
+        self._vel_alpha = self.get_parameter('vel_alpha').get_parameter_value().double_value
+        if not (0.0 <= self._vel_alpha < 1.0):
+            self._vel_alpha = 0.2
+        self._acc_alpha = self.get_parameter('acc_alpha').get_parameter_value().double_value
+        if not (0.0 <= self._acc_alpha < 1.0):
+            self._acc_alpha = 0.3
+        self._acc_decimation = self.get_parameter('acc_decimation').get_parameter_value().integer_value
+        if self._acc_decimation < 1:
+            self._acc_decimation = 10
+
+        # joint name -> _JointKinematics, and joint name -> (pos_pub, vel_pub, acc_pub)
+        self._kin: dict[str, _JointKinematics] = {}
+        self._pubs: dict[str, tuple] = {}
+
+        self._sub = self.create_subscription(JointState, topic, self._on_joint_state, 10)
+
+        self.get_logger().info(
+            f'JointKinematicsPublisher ready — listening on {topic}, publishing '
+            f'~/<joint>/position, ~/<joint>/velocity, ~/<joint>/acceleration for '
+            f'each joint.'
+        )
+        self.get_logger().info(
+            'Velocity source: ' + (
+                'msg.velocity (use_msg_velocity=true)' if self._use_msg_velocity
+                else 'differentiated position (Gazebo-safe; msg.velocity ignored)'
+            )
+            + f'; acceleration differentiated (decimation={self._acc_decimation}).'
+        )
+
+    def _ensure_publishers(self, name: str):
+        """Create the three Float64 publishers for a joint on first sight."""
+        if name in self._pubs:
+            return
+        # Namespaced under the node so topics appear as
+        # /joint_kinematics_publisher/<joint>/{position,velocity,acceleration}.
+        self._pubs[name] = (
+            self.create_publisher(Float64, f'~/{name}/position', 10),
+            self.create_publisher(Float64, f'~/{name}/velocity', 10),
+            self.create_publisher(Float64, f'~/{name}/acceleration', 10),
+        )
+        self._kin[name] = _JointKinematics(
+            self._vel_alpha, self._acc_alpha, self._acc_decimation)
+
+    def _on_joint_state(self, msg: JointState):
+        stamp_sec = msg.header.stamp.sec + msg.header.stamp.nanosec * 1e-9
+
+        for i, name in enumerate(msg.name):
+            if i >= len(msg.position):
+                continue
+            pos = msg.position[i]
+
+            msg_vel = None
+            if self._use_msg_velocity and i < len(msg.velocity):
+                msg_vel = msg.velocity[i]
+
+            self._ensure_publishers(name)
+            vel, acc = self._kin[name].update(pos, stamp_sec, msg_vel)
+
+            pos_pub, vel_pub, acc_pub = self._pubs[name]
+            pos_pub.publish(Float64(data=pos))
+            vel_pub.publish(Float64(data=vel))
+            if acc is not None:
+                acc_pub.publish(Float64(data=acc))
+
+
+def main(args=None):
+    rclpy.init(args=args)
+    node = JointKinematicsPublisherNode()
+    try:
+        rclpy.spin(node)
+    except KeyboardInterrupt:
+        pass
+    finally:
+        node.destroy_node()
+        rclpy.shutdown()
+
+
+if __name__ == '__main__':
+    main()
